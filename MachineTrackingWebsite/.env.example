DATABASE_URL=file:./dev.db
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-character-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email you want to send from
SMTP_PASS=app password for that email (not your normal email password, you need to create an app password in your email settings)
MAIL_FROM=email you want to send from (usually same as SMTP_USER)